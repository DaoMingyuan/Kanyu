// 堪舆基因 ABI（总规 §4.5 落地，v0.1 最小可用子集）。
// guest（基因）以 export 实现 analyzer；host（kanyu-gene）实例化并调用。
package kanyu:gene@0.1.0;

/// 分析型基因接口：FeatureCollection 进、FeatureCollection（或中文错误）出。
interface analyzer {
    /// 基因元数据（JSON：{"name","version","capabilities":[...]}）。
    meta: func() -> string;

    /// 执行：输入 FeatureCollection JSON，
    /// 返回结果 FeatureCollection JSON 或中文错误串。
    run: func(input: string) -> result<string, string>;
}

world gene {
    export analyzer;
}
